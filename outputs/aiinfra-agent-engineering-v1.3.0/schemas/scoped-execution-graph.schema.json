{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped execution evidence graph",
  "type": "object",
  "required": [
    "schema_version",
    "capture",
    "objects",
    "edges",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "scope",
        "id"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": [
        "source",
        "sha256",
        "reference_revision"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "ref",
        "kind",
        "evidence_id",
        "time"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "enum": [
            "node.dispatch",
            "chip.run",
            "chip.run.runner_run"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "clock_domain",
                "unit",
                "start",
                "duration"
              ],
              "properties": {
                "clock_domain": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "const": "us"
                },
                "start": {
                  "type": "number"
                },
                "duration": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "status",
        "evidence_ids",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "$ref": "#/$defs/ref"
        },
        "to": {
          "$ref": "#/$defs/ref"
        },
        "relation": {
          "enum": [
            "dispatch_corresponds_to_call",
            "call_contains_runner"
          ]
        },
        "status": {
          "enum": [
            "confirmed",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "locator",
        "record"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "required": [
            "index"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "record": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "enum": [
                "node.dispatch",
                "chip.run",
                "chip.run.runner_run"
              ]
            },
            "args": {
              "type": "object"
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
