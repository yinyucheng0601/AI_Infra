{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped relation graph",
  "type": "object",
  "required": [
    "schema_version",
    "objects",
    "edges",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "scope",
        "id"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [],
      "properties": {
        "build": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "step": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "case": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": [
        "clock",
        "unit",
        "start",
        "end"
      ],
      "properties": {
        "clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "unit": {
          "enum": [
            "ns",
            "us",
            "ms",
            "s"
          ]
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": [
        "ref",
        "kind"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "source",
        "locator",
        "level",
        "supports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "level": {
          "enum": [
            "observed",
            "derived",
            "assumed",
            "unknown"
          ]
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "relation",
        "mapping_status",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "from": {
          "$ref": "#/$defs/ref"
        },
        "to": {
          "$ref": "#/$defs/ref"
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mapping_status": {
          "enum": [
            "exact",
            "candidate",
            "ambiguous",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  }
}
