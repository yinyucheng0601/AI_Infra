{
  "id": "critical-path-swimlane",
  "kind": "rendered-pattern",
  "entry": "index.html",
  "embed": "pattern.html",
  "renderer": "pattern.js",
  "styles": [
    "tokens.css",
    "pattern.css",
    "liquid-glass/liquid-glass.css"
  ],
  "data": "data.js",
  "provenance": "provenance.json",
  "api": {
    "mount": "CriticalPathSwimlane.mount(root,data,options)",
    "instance": [
      "setStep(id)",
      "getState()",
      "destroy()"
    ]
  },
  "workbench": {
    "entry": "workbench.js",
    "mount": "CriticalPathWorkbench.mount(root,data,call,options)",
    "version": 1,
    "axis": "trace-time",
    "layout": "investigation-workbench",
    "controls": ["zoom", "inspector"],
    "traceEvidenceControls": ["eventEvidence", "playback"],
    "reference": "README.md"
  },
  "sourceParity": "semantic extraction; source module unchanged; shared scale and lane identities retained",
  "status": "reviewed",
  "validation": {
    "data": "54 steps / 864 lanes checked against raw STRACE",
    "browser": "pending user acceptance",
    "review": "2026-10-20 user requested Library / Pattern inclusion after screenshot review"
  },
  "dependencies": [
    "liquid-glass/liquid-glass.js"
  ]
}
